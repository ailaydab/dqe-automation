pipeline {
    agent any
 
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
 
        stage('Install Dependencies') {
            steps {
                sh 'pip install -r requirements.txt'
            }
        }
 
        stage('Run Parquet DQ Tests') {
            steps {
                sh 'pytest -m parquet_data --html=html_report/report_task3.html --self-contained-html || true'
            }
        }
    }
 
    post {
        always {
            archiveArtifacts artifacts: 'html_report/**/*', allowEmptyArchive: true
        }
    }
}